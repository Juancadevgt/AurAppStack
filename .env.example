# =====================================
# AurAppStack - Environment variables
# =====================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AurAppStack

# Supabase (https://supabase.com -> tu proyecto -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Comisión del marketplace (en porcentaje, ej: 20 = 20%)
MARKETPLACE_COMMISSION_PCT=20

# Resend (https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@tudominio.com

# Admin (correo del owner para acceso a /admin)
ADMIN_EMAIL=admin@tudominio.com
